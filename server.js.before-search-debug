      deleteAvatarFile(user.avatar);

      user.avatar =
        `/uploads/avatars/${req.file.filename}`;

      user.updatedAt = now();

      await saveDatabase();

      io.emit("profile:update", {
        user: cleanUser(user)
      });

      res.json({
        ok: true,
        message:
          "Profile picture updated",
        user: cleanUser(user)
      });
    } catch (error) {
      if (req.file) {
        deleteFile(
          `/uploads/avatars/${req.file.filename}`
        );
      }

      next(error);
    }
  }
);

