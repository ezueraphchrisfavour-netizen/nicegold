app.post(
  "/api/messages/:messageId/reactions",
  authMiddleware,
  async (req, res, next) => {
    try {
      const db = getDatabase();

      const message =
        db.data.messages.find(
          (item) =>
            item.id ===
            req.params.messageId
        );

      if (!message) {
        return res.status(404).json({
          ok: false,
          error: "Message not found"
        });
      }

      const emoji = String(
        req.body.emoji || ""
      );

      if (
        !ALLOWED_REACTIONS.includes(
          emoji
        )
      ) {
        return res.status(400).json({
          ok: false,
          error:
            "Unsupported reaction"
        });
      }

      const existing =
        db.data.reactions.find(
          (reaction) =>
            reaction.messageId ===
              message.id &&
            reaction.userId ===
              req.auth.userId
        );

      if (existing) {
        if (
          existing.emoji ===
          emoji
        ) {
          db.data.reactions =
            db.data.reactions.filter(
              (reaction) =>
                reaction.id !==
                existing.id
            );
        } else {
          existing.emoji = emoji;
          existing.updatedAt = now();
        }
      } else {
        db.data.reactions.push({
          id: createId("react_"),
          messageId: message.id,
          conversationId:
            message.conversationId,
          userId:
            req.auth.userId,
          emoji,
          createdAt: now(),
          updatedAt: now()
        });
      }

      await saveDatabase();

      const reactions =
        db.data.reactions.filter(
          (reaction) =>
            reaction.messageId ===
            message.id
        );

      io.to(
        `conversation:${message.conversationId}`
      ).emit(
        "reaction:update",
        {
          messageId: message.id,
          reactions
        }
      );

      res.json({
